BITMIND_API_KEY=
BITMIND_DETECT_URL=https://api.bitmind.ai/oracle/v1/34/detect-image
BITMIND_APPLICATION=oracle-api
BITMIND_TIMEOUT_SECONDS=60

# Optional VLM visual review. Keep DETECTOR_ENABLE_VLM=0 for normal use; set it to 1 for demos.
OPENAI_API_KEY=
OPENAI_VLM_MODEL=gpt-4.1-mini
OPENAI_VLM_URL=https://api.openai.com/v1/responses
OPENAI_VLM_TIMEOUT_SECONDS=45
OPENAI_VLM_DETAIL=auto
DETECTOR_ENABLE_VLM=0

# Set to 0 only when you want the app to return heuristic fallback results if the provider is unavailable.
DETECTOR_DISABLE_FALLBACK=1
DETECTOR_AI_THRESHOLD=60
DETECTOR_FALLBACK_AI_THRESHOLD=90
DETECTOR_DISABLE_ROBUSTNESS=0

# Leave blank when using the Vite dev proxy. Set this for deployed frontends.
VITE_API_BASE_URL=
